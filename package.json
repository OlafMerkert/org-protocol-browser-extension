{
  "name": "org-protocol-browser-extension",
  "version": "1.12",
  "description": "Trigger org-capture from the browser via org-protocol.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OlafMerkert/org-protocol-browser-extension"
  },
  "author": "Olaf Merkert <olaf@m-merkert.de>",
  "dependencies": {
    "ramda": "^0.32.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "web-ext": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@happy-dom/global-registrator": "^20.8.7",
    "@types/bun": "^1.3.11",
    "@types/chrome": "^0.1.38",
    "@types/ramda": "^0.31.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "build": "NODE_ENV=production bun run scripts/bun.build.ts",
    "build:chrome": "BROWSER=chrome bun run build",
    "build:firefox": "BROWSER=firefox bun run build",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:extension": "web-ext lint -s target/dist",
    "package:chrome": "cd dist && zip -r ../target/chrome/extension.zip .",
    "package:firefox": "web-ext build -s target/dist -a target",
    "package:firefox:signed": "web-ext sign -s target/dist -a target --channel unlisted",
    "start:firefox": "web-ext run -s target/dist",
    "typecheck": "tsc"
  }
}
